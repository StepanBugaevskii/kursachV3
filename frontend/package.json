{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "export": "next export",
    "build:pwa": "next build",
    "build:desktop": "cross-env ELECTRON_BUILD=true next build && electron-builder",
    "start": "next start -p 3001",
    "lint": "eslint",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && npm run electron\"",
    "electron:build:win": "cross-env ELECTRON_BUILD=true NODE_OPTIONS=--max-old-space-size=4096 next build && electron-builder --win",
    "electron:build:mac": "cross-env ELECTRON_BUILD=true NODE_OPTIONS=--max-old-space-size=4096 next build && electron-builder --mac",
    "electron:build:linux": "cross-env ELECTRON_BUILD=true NODE_OPTIONS=--max-old-space-size=4096 next build && electron-builder --linux"
  },
  "build": {
    "appId": "com.meshnetwork.app",
    "productName": "MeshShare",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@types/crypto-js": "^4.2.2",
    "antd": "^6.3.4",
    "axios": "^1.13.6",
    "crypto-js": "^4.2.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
